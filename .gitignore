# Streamline runtime binaries are copied from the SDK zip; keep headers/libs/docs only
/port/third_party/streamline/bin/

# Packaged releases (tools/package_release.py)
/release/

# Port run-time user data (memory card, Slippi user folder)
/User/
/melee_port.log

# Private working notes, never published
HANDOFF_*.md
NOTE_FOR_*.md

# Discord webhook URL for release announcements (secret, never commit)
discord-webhook.txt
.discord-webhook

# Per-agent and per-feature build directories
build-*/
*-build.err

# Cygwin/MSYS crash dumps, written into whatever directory the shell was in
*.stackdump

# Plain ISO converted from a .ciso by build.bat / play.bat (tools/ciso_to_iso.py)
/melee.iso
/melee.iso.tmp
